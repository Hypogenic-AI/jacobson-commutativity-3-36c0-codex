{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nfrom collections import defaultdict\np=7\nq=p**3\nM=(q-1)//3 # 114 for S\"'^M=1\n# K = F_p[a]/(a''^3 + a''^2 + 1), so a''^3 = -a''^2 -1\nmod_coeff=[1,0,1,1]  # c0,c1,c2,c3 for g? not used\n\ndef k_add(x,y): return tuple((x[i]+y[i])%p for i in range(3))\ndef k_neg(x): return tuple((-x[i])%p for i in range(3))\ndef k_sub(x,y): return tuple((x[i]-y[i])%p for i in range(3))\ndef k_mul(x,y):\n    tmp=[0]*5\n    for i,a in enumerate(x):\n        for j,b in enumerate(y): tmp[i+j]=(tmp[i+j]+a*b)%p\n    # reduce degree 4 then 3 using a''^3 = -a''^2 -1\n    for d in [4,3]:\n        c=tmp[d]%p\n        if c:\n            tmp[d]=0\n            # a''^d = a''^(d-3)*a''^3 = -a''^(d-1) - a''^(d-3)\n            tmp[d-1]=(tmp[d-1]-c)%p\n            tmp[d-3]=(tmp[d-3]-c)%p\n    return tuple(tmp[:3])\ndef k_pow(x,n):\n    r=(1,0,0); b=x\n    while n:\n        if n&1: r=k_mul(r,b)\n        b=k_mul(b,b); n//=2\n    return r\ndef k_scalar(c): return (c%p,0,0)\ndef k_iszero(x): return all(v%p==0 for v in x)\nalpha=(0,1,0)\n# verify g(alpha)=0 and alpha''^q=alpha\nprint('\"'alpha\"'^q-alpha'\"', k_sub(k_pow(alpha,q),alpha), 'alpha\"'^p'\"', k_pow(alpha,p))\n# sigma\"'^i = p''^i power\ndef sigma(x,i): return k_pow(x,p**(i%3))\n# S-poly: list length M of K coeffs, modulo S''^M=1\ndef sp_zero(): return [(0,0,0)]*M\ndef sp_one():\n    a=sp_zero(); a[0]=(1,0,0); return a\ndef sp_const(c):\n    a=sp_zero(); a[0]=c; return a\ndef sp_add(A,B): return [k_add(A[i],B[i]) for i in range(M)]\ndef sp_sub(A,B): return [k_sub(A[i],B[i]) for i in range(M)]\ndef sp_neg(A): return [k_neg(A[i]) for i in range(M)]\ndef sp_mul(A,B):\n    C=[(0,0,0)]*M\n    for i,a in enumerate(A):\n        if k_iszero(a): continue\n        for j,b in enumerate(B):\n            if k_iszero(b): continue\n            C[(i+j)%M]=k_add(C[(i+j)%M], k_mul(a,b))\n    return C\ndef sp_sigma(A,i): return [sigma(c,i) for c in A]\n# element as tuple of 3 S-polys coeff for B''^0,B''^1,B''^2\ndef e_zero(): return (sp_zero(),sp_zero(),sp_zero())\ndef e_one(): return (sp_one(),sp_zero(),sp_zero())\ndef e_add(U,V): return tuple(sp_add(U[i],V[i]) for i in range(3))\ndef e_sub(U,V): return tuple(sp_sub(U[i],V[i]) for i in range(3))\ndef e_mul(U,V):\n    C=[sp_zero(),sp_zero(),sp_zero()]\n    for i,A in enumerate(U):\n        if all(k_iszero(c) for c in A): continue\n        for j,B in enumerate(V):\n            if all(k_iszero(c) for c in B): continue\n            # (A B''^i)(Bcoef B''^j)= A sigma''^i(Bcoef) S''^carry B''^r\n            prod=sp_mul(A, sp_sigma(B,i))\n            carry=(i+j)//3; r=(i+j)%3\n            if carry:\n                # multiply by S''^1\n                prod=prod[-carry:]+prod[:-carry]\n            C[r]=sp_add(C[r],prod)\n    return tuple(C)\ndef e_pow(U,n):\n    R=e_one(); B=U\n    while n:\n        if n&1: R=e_mul(R,B)\n        B=e_mul(B,B); n//=2\n    return R\ndef e_constK(c): return (sp_const(c),sp_zero(),sp_zero())\ndef e_B(t=1): return (sp_zero(),sp_const(k_scalar(t)),sp_zero())\nA=e_constK(alpha)\nfor t in range(1,p):\n    U=e_add(A,e_B(t))\n    D=e_sub(e_pow(U,q),U)\n    nz=[]\n    for comp in range(3):\n        cnt=sum(0 if k_iszero(c) else 1 for c in D[comp])\n        nz.append(cnt)\n    print('\"'t',t,'nonzero coeff counts',nz)\n    # print first few nonzero in each comp\n    for comp in range(3):\n        shown=0\n        for idx,c in enumerate(D[comp]):\n            if not k_iszero(c):\n                print(' comp',comp,'S\"'^'\"',idx,'coeff',c)\n                shown+=1\n                if shown>=5: break\n    print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
