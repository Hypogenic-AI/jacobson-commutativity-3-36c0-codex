{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\n# Reuse compact functions to compute gcd over K for p=7, g=a\"'^3+a''^2+1\np=7; q=p**3; M=(q-1)//3\n\ndef k_add(x,y): return tuple((x[i]+y[i])%p for i in range(3))\ndef k_neg(x): return tuple((-x[i])%p for i in range(3))\ndef k_sub(x,y): return tuple((x[i]-y[i])%p for i in range(3))\ndef k_mul(x,y):\n    tmp=[0]*5\n    for i,a in enumerate(x):\n        for j,b in enumerate(y): tmp[i+j]=(tmp[i+j]+a*b)%p\n    for d in [4,3]:\n        c=tmp[d]%p\n        if c:\n            tmp[d]=0; tmp[d-1]=(tmp[d-1]-c)%p; tmp[d-3]=(tmp[d-3]-c)%p\n    return tuple(tmp[:3])\ndef k_pow(x,n):\n    r=(1,0,0); b=x\n    while n:\n        if n&1: r=k_mul(r,b)\n        b=k_mul(b,b); n//=2\n    return r\ndef k_inv(x):\n    assert x!=(0,0,0)\n    return k_pow(x,q-2)\ndef k_iszero(x): return x==(0,0,0)\ndef k_scalar(c): return (c%p,0,0)\ndef sigma(x,i): return k_pow(x,p**(i%3))\nalpha=(0,1,0)\n# S poly functions length M modulo S''^M-1\ndef sp_zero(): return [(0,0,0)]*M\ndef sp_const(c):\n    A=sp_zero(); A[0]=c; return A\ndef sp_add(A,B): return [k_add(A[i],B[i]) for i in range(M)]\ndef sp_sub(A,B): return [k_sub(A[i],B[i]) for i in range(M)]\ndef sp_mul(A,B):\n    C=[(0,0,0)]*M\n    for i,a in enumerate(A):\n        if k_iszero(a): continue\n        for j,b in enumerate(B):\n            if k_iszero(b): continue\n            C[(i+j)%M]=k_add(C[(i+j)%M], k_mul(a,b))\n    return C\ndef sp_sigma(A,i): return [sigma(c,i) for c in A]\ndef e_one(): return (sp_const((1,0,0)), sp_zero(), sp_zero())\ndef e_add(U,V): return tuple(sp_add(U[i],V[i]) for i in range(3))\ndef e_sub(U,V): return tuple(sp_sub(U[i],V[i]) for i in range(3))\ndef e_mul(U,V):\n    C=[sp_zero(),sp_zero(),sp_zero()]\n    for i,A in enumerate(U):\n        if all(k_iszero(c) for c in A): continue\n        for j,B in enumerate(V):\n            if all(k_iszero(c) for c in B): continue\n            prod=sp_mul(A, sp_sigma(B,i))\n            carry=(i+j)//3; r=(i+j)%3\n            if carry: prod=prod[-carry:]+prod[:-carry]\n            C[r]=sp_add(C[r], prod)\n    return tuple(C)\ndef e_pow(U,n):\n    R=e_one(); B=U\n    while n:\n        if n&1: R=e_mul(R,B)\n        B=e_mul(B,B); n//=2\n    return R\ndef e_constK(c): return (sp_const(c),sp_zero(),sp_zero())\ndef e_B(t): return (sp_zero(),sp_const(k_scalar(t)),sp_zero())\n# polynomial gcd over K, low-to-high\ndef trim(f):\n    f=f[:]\n    while f and k_iszero(f[-1]): f.pop()\n    return f\ndef deg(f): return len(trim(f))-1\ndef monic(f):\n    f=trim(f)\n    if not f: return []\n    inv=k_inv(f[-1]); return [k_mul(c,inv) for c in f]\ndef divmod_poly(f,g):\n    f=trim(f); g=trim(g)\n    if not g: raise ZeroDivisionError\n    qpoly=[(0,0,0)]*max(1,(len(f)-len(g)+1))\n    inv=k_inv(g[-1])\n    while len(f)>=len(g) and f:\n        coeff=k_mul(f[-1],inv); shift=len(f)-len(g)\n        qpoly[shift]=coeff\n        for i,gi in enumerate(g):\n            f[shift+i]=k_sub(f[shift+i], k_mul(coeff,gi))\n        f=trim(f)\n    return trim(qpoly), f\ndef gcd_poly(f,g):\n    f=trim(f); g=trim(g)\n    while g:\n        _,r=divmod_poly(f,g); f,g=g,r\n    return monic(f)\ndef sp_to_poly(A): return trim(A)\nS_M_minus_1=[(6,0,0)]+[(0,0,0)]*(M-1)+[(1,0,0)]\nA=e_constK(alpha)\nfor t in [1,2,3,4,5,6]:\n    D=e_sub(e_pow(e_add(A,e_B(t)),q), e_add(A,e_B(t)))\n    G=S_M_minus_1\n    count=0\n    for comp in range(3):\n        # use K polynomial coefficients directly\n        poly=sp_to_poly(D[comp])\n        if poly:\n            G=gcd_poly(G, poly); count+=1\n        # also coordinates? K gcd enough\n    print('\"'t',t,'gcd degree over K',deg(G),'gcd',G[:5], '... len',len(G))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
